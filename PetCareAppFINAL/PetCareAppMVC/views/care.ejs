<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Daily Care Planner</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>main{max-width:56rem;margin:auto;padding:2rem 1rem}section{padding:1.4rem;margin:1rem 0;border:1px solid #cadbd3;border-radius:1rem}h1,h2{color:#194735}label{display:block;margin:.6rem 0}button,select,input{padding:.35rem .6rem}li form{display:inline}li{margin:.4rem 0}</style></head><body>
<%- include('partials/navbar',{session}) %><main><h1>Daily Care Planner</h1><p><%= day %> · Singapore time</p>
<% const labels=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; if(!pets.length){ %><a href="/pets/new">Add your first pet to start planning</a><% } else { %>
<section><h2>Today’s checklist</h2><% const tasks=routines.filter(r=>due(r,day)); if(!tasks.length){ %>No routines due today.<% } %><ul>
<% for(const r of tasks){ const checked=done.has(r.id+'/'+day); %><li><strong><%= r.clock %> · <%= r.name %></strong> — <%= r.title %> · <%= checked?'Completed':'Pending' %>
<form action="/care/<%= r.id %>/check" method="post"><input type="hidden" name="day" value="<%= day %>"><button name="action" value="<%= checked?'undo':'done' %>"><%= checked?'Undo':'Mark done' %></button></form></li><% } %></ul></section>
<section><h2>Recurring routines</h2><form action="/care/routines" method="post"><label>Pet <select name="pet"><% for(const p of pets){ %><option value="<%= p.id %>"><%= p.name %></option><% } %></select></label>
<label>Routine <input name="title" required maxlength="100" placeholder="Morning walk"></label><label>Time <input type="time" required name="clock"></label><label>Repeat <select name="weekday"><option value="daily">Every day</option><% labels.forEach((name,i)=>{ %><option value="<%= i %>">Every <%= name %></option><% }) %></select></label><button>Add routine</button></form><ul>
<% for(const r of routines.filter(r=>!r.ends)){ %><li><%= r.name %> · <%= r.title %> · <%= r.clock %> · <%= r.weekday===null?'Daily':labels[r.weekday] %> <form action="/care/<%= r.id %>/stop" method="post"><button>Stop after today</button></form></li><% } %></ul></section>
<section><h2>Weekly care history</h2><form action="/care"><label>Pet <select name="pet"><% for(const p of pets){ %><option value="<%= p.id %>" <%= selected.id===p.id?'selected':'' %>><%= p.name %></option><% } %></select></label><button>Show history</button></form>
<% for(const d of days){ const items=routines.filter(r=>r.pet_id===selected.id && due(r,d)); %><h3 class="h6 mt-3"><%= d %></h3><% if(!items.length){ %>Nothing scheduled.<% } %><ul><% for(const r of items){ %><li><%= r.clock %> · <%= r.title %> — <%= done.has(r.id+'/'+d)?'Completed':d===day?'Pending':'Missed' %></li><% } %></ul><% } %></section><% } %></main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
